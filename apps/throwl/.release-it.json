{
  "$schema": "https://unpkg.com/release-it@19/schema/release-it.json",
  "npm": {
    "publish": false
  },
  "git": {
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "changelog": "node ../../scripts/store-release.mjs notes"
  },
  "github": {
    "release": true,
    "draft": true
  },
  "hooks": {
    "after:bump": "nx run throwl:syncNativeVersions --args=\"--version=${version}\""
  }
}

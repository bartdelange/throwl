{
  "name": "@throwl/throwl",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/throwl/src",
  "projectType": "application",
  "tags": ["type:app", "scope:throwl"],
  "// targets": "to see all targets run: nx show project @throwl/feature-auth --web",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "react-native start"
      }
    },
    "pod-install": {
      "executor": "nx:run-commands",
      "dependsOn": ["writeXcodeEnv"],
      "options": {
        "cwd": "{projectRoot}/ios",
        "command": "bundle exec pod install"
      }
    },
    "run-android": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "react-native run-android"
      }
    },
    "run-ios": {
      "executor": "nx:run-commands",
      "dependsOn": ["writeXcodeEnv"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "react-native run-ios"
      }
    },
    "build-ios": {
      "executor": "nx:run-commands",
      "dependsOn": ["writeXcodeEnv"],
      "options": {
        "cwd": "{projectRoot}/ios",
        "command": "xcodebuild -workspace Throwl.xcworkspace -scheme Throwl -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build"
      }
    },
    "build-android": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}/android",
        "command": "./gradlew assembleDebug"
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "react-native bundle --platform ios --dev false --entry-file src/main.tsx --bundle-output /tmp/throwl-main.jsbundle --assets-dest /tmp/throwl-bundle-assets"
      }
    },
    "writeXcodeEnv": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "env -u PREFIX node ../../scripts/write-xcode-env.js"
      }
    },
    "setAndroidVersion": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bundle exec fastlane android bump_version version={args.version}"
      }
    },
    "setIosVersion": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bundle exec fastlane ios bump_version version={args.version}"
      }
    },
    "syncNativeVersions": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "nx run throwl:setAndroidVersion --version={args.version}",
          "nx run throwl:setIosVersion --version={args.version}",
          "git add -A"
        ],
        "parallel": false
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "release-it"
      }
    },
    "deploy:android": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bundle exec fastlane android beta"
      }
    },
    "deploy:ios": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bundle exec fastlane ios beta"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "tsc -b ./apps/throwl/tsconfig.app.json --emitDeclarationOnly"
      }
    }
  }
}

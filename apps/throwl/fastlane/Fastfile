require "base64"
require "json"
require "tmpdir"
require "fileutils"

default_platform(:ios)

DEVELOPER_APP_IDENTIFIER = ENV.fetch("DEVELOPER_APP_IDENTIFIER", nil)
APPLE_ISSUER_ID = ENV.fetch("APPLE_ISSUER_ID", nil)
APPLE_KEY_ID = ENV.fetch("APPLE_KEY_ID", nil)
APPLE_KEY_CONTENT = ENV.fetch("APPLE_KEY_CONTENT", nil)

def testflight_api_key
  app_store_connect_api_key(
    key_id: APPLE_KEY_ID,
    issuer_id: APPLE_ISSUER_ID,
    key_content: APPLE_KEY_CONTENT,
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  desc "Bump marketing version and build number"
  lane :bump_version do |options|
    increment_version_number(
      version_number: options.fetch(:version),
      xcodeproj: "ios/Throwl.xcodeproj"
    )
    increment_build_number(xcodeproj: "ios/Throwl.xcodeproj")
  end

  desc "Build (and optionally upload) a TestFlight release bundle"
  lane :beta do |options|
    setup_ci

    cocoapods(
      deployment: true,
      podfile: "ios/Podfile"
    )

    match(
      type: "appstore",
      app_identifier: DEVELOPER_APP_IDENTIFIER,
      api_key: testflight_api_key
    )

    build_app(
      scheme: "Throwl",
      workspace: "ios/Throwl.xcworkspace",
      clean: true,
      export_method: "app-store",
      output_directory: "fastlane/output",
      output_name: "Throwl.ipa"
    )

    if options.fetch(:upload, true).to_s.downcase == "true"
      upload(ipa: lane_context[SharedValues::IPA_OUTPUT_PATH])
    end
  end

  desc "Upload an existing signed IPA to TestFlight"
  lane :upload do |options|
    upload_to_testflight(
      ipa: options.fetch(:ipa),
      api_key: testflight_api_key,
      app_identifier: DEVELOPER_APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "Submit the approved TestFlight build for automatic release after App Review"
  lane :submit_tested_build do |options|
    notes = JSON.parse(File.read(options.fetch(:notes)))
    deliver(
      api_key: testflight_api_key,
      app_identifier: DEVELOPER_APP_IDENTIFIER,
      app_version: options.fetch(:version).to_s,
      build_number: options.fetch(:build).to_s,
      release_notes: notes.transform_values { |entry| entry.fetch("whatsNew") },
      promotional_text: notes.filter { |_, entry| entry.key?("iosPromotionalText") }
        .transform_values { |entry| entry.fetch("iosPromotionalText") },
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      automatic_release: true,
      submit_for_review: true
    )
  end
end

platform :android do
  desc "Bump versionName and versionCode"
  lane :bump_version do |options|
    android_set_version_name(
      version_name: options.fetch(:version),
      gradle_file: "android/app/build.gradle"
    )
    android_set_version_code(gradle_file: "android/app/build.gradle")
  end

  desc "Build (and optionally upload) a Beta/Release bundle"
  lane :beta do |options|
    should_upload = options.fetch(:upload, ENV.fetch("UPLOAD", "true")).to_s.downcase == "true"

    gradle(
      project_dir: "android",
      task: "bundleRelease"
    )

    aab_path = "android/app/build/outputs/bundle/release/app-release.aab"

    if should_upload
      upload(aab: aab_path)
    else
      UI.important("UPLOAD=false -> skipping upload_to_play_store (dry run)")
      UI.message("Built AAB should be at: #{aab_path}")
    end
  end

  desc "Upload an existing signed AAB to Play Internal"
  lane :upload do |options|
    upload_to_play_store(
      aab: options.fetch(:aab),
      track: "internal"
    )
  end

  desc "Promote the approved Play Internal build and send it for production review"
  lane :submit_tested_build do |options|
    code = Integer(options.fetch(:build))
    Dir.mktmpdir("throwl-play-release") do |temporary|
      metadata = File.join(temporary, "metadata")
      credentials = File.join(temporary, "credentials.json")
      File.write(credentials, Base64.strict_decode64(ENV.fetch("PLAY_CONFIG_JSON")), perm: 0o600)
      JSON.parse(File.read(options.fetch(:notes))).each do |locale, entry|
        directory = File.join(metadata, locale, "changelogs")
        FileUtils.mkdir_p(directory)
        File.write(File.join(directory, "#{code}.txt"), entry.fetch("whatsNew"))
      end

      upload_to_play_store(
        json_key: credentials,
        track: "internal",
        track_promote_to: "production",
        version_code: code,
        metadata_path: metadata,
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        changes_not_sent_for_review: false,
        rescue_changes_not_sent_for_review: false
      )
    end
  end
end

{
  "name": "@throwl/workspace",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "lint:check": "nx run-many --target=lint --all --parallel --maxParallel=5",
    "lint:fix": "nx run-many --target=lint --all --parallel --maxParallel=5 --fix",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "typecheck": "nx run-many --target=typecheck --all --parallel --maxParallel=5",
    "build": "nx run-many --target=build --all --parallel --maxParallel=3",
    "test": "nx run-many --target=test --all --parallel --maxParallel=5",
    "test:firestore-rules": "firebase emulators:exec --project demo-throwl-rules --only firestore \"node --test firebase/firestore.rules.test.mjs\"",
    "test:migration": "node --test scripts/firestore-migration-operations.test.mjs scripts/firestore-migration-friendships.test.mjs scripts/firestore-migration-plan.test.mjs scripts/clone-firestore-data.test.mjs",
    "migrate:firestore": "node scripts/migrate-firestore-schema.mjs",
    "migrate:clone-firestore": "node scripts/clone-firestore-data.mjs",
    "test:affected": "nx affected --target=test --parallel --maxParallel=5",
    "postinstall": "husky"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.28.6",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@nx/eslint": "22.3.3",
    "@nx/eslint-plugin": "22.3.3",
    "@nx/jest": "22.3.3",
    "@nx/js": "22.3.3",
    "@nx/web": "22.3.3",
    "@nx/webpack": "22.3.3",
    "@nx/workspace": "22.3.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@svgr/webpack": "^8.0.1",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@testing-library/react-native": "~13.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.0.6",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/parser": "^8.53.0",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-native": "^5.0.0",
    "firebase": "12.2.1",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.27.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.0.2",
    "jest-util": "^30.0.2",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "metro-config": "~0.87.0",
    "metro-resolver": "~0.87.0",
    "nx": "22.3.3",
    "pod-install": "^1.0.9",
    "prettier": "~3.6.2",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-refresh": "^0.10.0",
    "react-test-renderer": "19.2.3",
    "release-it": "^19.2.3",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",

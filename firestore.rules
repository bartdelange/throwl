rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRef(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isOwnUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 80;
    }

    function validEmail(email) {
      return email is string && email.size() > 2 && email.size() <= 254;
    }

    function validUser(data) {
      return data.keys().hasOnly(['email', 'name'])
        && validEmail(data.email)
        && validName(data.name);
    }

    function validPublicProfile(data) {
      return data.keys().hasOnly(['name']) && validName(data.name);
    }

    function validLookup(data, uid) {
      return data.keys().hasOnly(['user']) && data.user == userRef(uid);
    }

    function validEmailChange(uid) {
      return request.resource.data.email == resource.data.email
        || (!existsAfter(/databases/$(database)/documents/userLookups/$(resource.data.email.lower()))
          && getAfter(/databases/$(database)/documents/userLookups/$(request.resource.data.email.lower())).data.user == userRef(uid));
    }

    function member(data) {
      return signedIn() && data.userIds.hasAny([request.auth.uid]);
    }

    function validFriendship(data) {
      return data.keys().hasOnly(['requester', 'status', 'userIds'])
        && data.status in ['pending', 'accepted']
        && data.requester is string
        && data.userIds is list
        && data.userIds.size() == 2
        && data.userIds[0] is string
        && data.userIds[1] is string
        && data.userIds[0] != data.userIds[1]
        && data.userIds[0] < data.userIds[1]
        && data.userIds.hasAny([data.requester]);
    }

    function ownsGame(data) {
      return signedIn() && data.owner == request.auth.uid;
    }

    function gameMember(data) {
      return signedIn() && data.playerIds.hasAny([request.auth.uid]);
    }

    function canonicalFriendshipId(left, right) {
      return left < right ? left + '_' + right : right + '_' + left;
    }

    function registeredPlayerRefs(playerIds) {
      return (playerIds.size() <= 0 ? [].toSet() : [userRef(playerIds[0])].toSet())
        .union(playerIds.size() <= 1 ? [].toSet() : [userRef(playerIds[1])].toSet())
        .union(playerIds.size() <= 2 ? [].toSet() : [userRef(playerIds[2])].toSet())
        .union(playerIds.size() <= 3 ? [].toSet() : [userRef(playerIds[3])].toSet())
        .union(playerIds.size() <= 4 ? [].toSet() : [userRef(playerIds[4])].toSet())
        .union(playerIds.size() <= 5 ? [].toSet() : [userRef(playerIds[5])].toSet())
        .union(playerIds.size() <= 6 ? [].toSet() : [userRef(playerIds[6])].toSet())
        .union(playerIds.size() <= 7 ? [].toSet() : [userRef(playerIds[7])].toSet())
        .union(playerIds.size() <= 8 ? [].toSet() : [userRef(playerIds[8])].toSet())
        .union(playerIds.size() <= 9 ? [].toSet() : [userRef(playerIds[9])].toSet());
    }

    function validPlayerEntry(player, registeredPlayers) {
      return validName(player) || registeredPlayers.hasAny([player]);
    }

    function validPlayerEntries(players, registeredPlayers) {
      return (players.size() <= 0 || validPlayerEntry(players[0], registeredPlayers))
        && (players.size() <= 1 || validPlayerEntry(players[1], registeredPlayers))
        && (players.size() <= 2 || validPlayerEntry(players[2], registeredPlayers))
        && (players.size() <= 3 || validPlayerEntry(players[3], registeredPlayers))
        && (players.size() <= 4 || validPlayerEntry(players[4], registeredPlayers))
        && (players.size() <= 5 || validPlayerEntry(players[5], registeredPlayers))
        && (players.size() <= 6 || validPlayerEntry(players[6], registeredPlayers))
        && (players.size() <= 7 || validPlayerEntry(players[7], registeredPlayers))
        && (players.size() <= 8 || validPlayerEntry(players[8], registeredPlayers))
        && (players.size() <= 9 || validPlayerEntry(players[9], registeredPlayers))
        && (players.size() <= 10 || validPlayerEntry(players[10], registeredPlayers))
        && (players.size() <= 11 || validPlayerEntry(players[11], registeredPlayers))
        && (players.size() <= 12 || validPlayerEntry(players[12], registeredPlayers))
        && (players.size() <= 13 || validPlayerEntry(players[13], registeredPlayers))
        && (players.size() <= 14 || validPlayerEntry(players[14], registeredPlayers))
        && (players.size() <= 15 || validPlayerEntry(players[15], registeredPlayers));
    }

    function registeredPlayersInOrder(players, playerIds) {
      return (playerIds.size() <= 0 || players[0] == userRef(playerIds[0]))
        && (playerIds.size() <= 1 || players[1] == userRef(playerIds[1]))
        && (playerIds.size() <= 2 || players[2] == userRef(playerIds[2]))
        && (playerIds.size() <= 3 || players[3] == userRef(playerIds[3]))
        && (playerIds.size() <= 4 || players[4] == userRef(playerIds[4]))
        && (playerIds.size() <= 5 || players[5] == userRef(playerIds[5]))
        && (playerIds.size() <= 6 || players[6] == userRef(playerIds[6]))
        && (playerIds.size() <= 7 || players[7] == userRef(playerIds[7]))
        && (playerIds.size() <= 8 || players[8] == userRef(playerIds[8]))
        && (playerIds.size() <= 9 || players[9] == userRef(playerIds[9]));
    }

    function mixedPlayersMatch(players, playerIds) {
      let registeredPlayers = registeredPlayerRefs(playerIds);
      return players.toSet().hasAll(registeredPlayers)
        && validPlayerEntries(players, registeredPlayers);
    }

    function playerIdsMatchPlayers(players, playerIds) {
      return playerIds.size() > 0
        && playerIds.size() <= 10
        && playerIds.toSet().size() == playerIds.size()
        && players.toSet().size() == players.size()
        && ((players.size() == playerIds.size()
            && registeredPlayersInOrder(players, playerIds))
          || (players.size() > playerIds.size()
            && mixedPlayersMatch(players, playerIds)));
    }

    function boundedTurns(turns) {
      // Turn and throw semantics belong to the application parser. The bound is
      // retained to prevent an authorized writer from growing an embedded
      // history without limit.
      return turns is list && turns.size() <= 500;
    }

    function validGame(data) {
      return data.keys().hasOnly(['owner', 'playerIds', 'players', 'turns', 'started', 'finished', 'options', 'startingScore'])
        && data.keys().hasAll(['owner', 'playerIds', 'players', 'turns', 'started', 'finished', 'options'])
        && data.owner is string
        && data.playerIds is list
        && data.playerIds.hasAny([data.owner])
        && data.players is list
        && data.players.size() > 0
        && data.players.size() <= 16
        && playerIdsMatchPlayers(data.players, data.playerIds)
        && boundedTurns(data.turns)
        && data.started is timestamp
        && (data.finished == null || data.finished is timestamp);
    }

    function validGameUpdate(data, previousData) {
      return data.keys().hasOnly(['owner', 'playerIds', 'players', 'turns', 'started', 'finished', 'options', 'startingScore'])
        && data.diff(previousData).affectedKeys().hasOnly(['turns', 'finished'])
        && boundedTurns(data.turns)
        && (data.finished == null || data.finished is timestamp);
    }

    match /users/{uid} {
      allow get: if isOwnUser(uid);
      allow list: if false;
      allow create: if isOwnUser(uid)
        && validUser(request.resource.data)
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwnUser(uid)
        && validUser(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && validEmailChange(uid);
      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwnUser(uid)
        && validPublicProfile(request.resource.data)
        && request.resource.data.name == getAfter(userRef(uid)).data.name;
      allow delete: if false;
    }

    match /userLookups/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && email == request.auth.token.email.lower()
        && validLookup(request.resource.data, request.auth.uid);
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.user == userRef(request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow get, list: if member(resource.data);
      allow create: if validFriendship(request.resource.data)
        && friendshipId == canonicalFriendshipId(request.resource.data.userIds[0], request.resource.data.userIds[1])
        && request.resource.data.status == 'pending'
        && request.resource.data.requester == request.auth.uid
        && member(request.resource.data);
      allow update: if validFriendship(request.resource.data)
        && member(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && resource.data.requester != request.auth.uid;
      allow delete: if member(resource.data);
    }

    match /games/{gameId} {
      // Friend selection is product policy, not a data-access capability:
      // membership in one game grants no access to a player's private records.
      allow create: if ownsGame(request.resource.data)
        && validGame(request.resource.data);
      allow read, delete: if gameMember(resource.data);
      allow update: if gameMember(resource.data)
        && validGameUpdate(request.resource.data, resource.data);
    }
  }
}
